# Canonical origin. Set only to a domain configured for this site.
SITE_URL=https://jormanespinoza.netlify.app
# Optional: enables the migration map. Restrict this browser key by domain in Google Cloud.
GOOGLE_MAPS_API_KEY=
# Optional: create JavaScript Map IDs in Google Cloud and associate the imported light/dark map styles.
GOOGLE_MAPS_LIGHT_MAP_ID=
GOOGLE_MAPS_DARK_MAP_ID=
# Optional: the existing Next.js measurement ID was G-SZZ5X56S6P.
# Leave unset to disable Google Analytics.
PUBLIC_GA_MEASUREMENT_ID=
