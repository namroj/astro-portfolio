---
import ThemeSwitcher from "./ThemeSwitcher";
import FontSwitcher from "./FontSwitcher";
import LineNumberToggle from "./LineNumberToggle";
import DiagramStyleSwitcher from "./DiagramStyleSwitcher";
import { getCollection } from "astro:content";

import { localeFromPath, messages, unlocalizedPath } from "../i18n";
const locale = localeFromPath(Astro.url.pathname);
const m = messages[locale];
const currentPath = unlocalizedPath(Astro.url.pathname);
const postSlug = currentPath.startsWith("blog/") ? currentPath.slice(5) : "";
const currentPost = postSlug
  ? (await getCollection("blog")).find((post) => post.data.lang === locale && post.data.slug === postSlug)
  : undefined;
const hasMermaidDiagrams = currentPost
  ? currentPost.body?.includes("```mermaid") ?? false
  : false;
---

<aside id="preferences" class="preferences" inert aria-hidden="true" aria-labelledby="preferences-title">
  <div class="content">
    <h3 id="preferences-title" class="title">{m.preferences}</h3>
    <div class="switchers">
      <div class="group">
        <h4 class="title">{m.theme}</h4>
        <ThemeSwitcher client:load />
      </div>
      <div class="group">
        <h4 class="title">{m.developerFont}</h4>
        <FontSwitcher client:load />
      </div>
      {
        currentPath.startsWith("blog") && (
          <>
          <div class="group">
            <h4 class="title">{m.code}</h4>
            <LineNumberToggle client:load label={m.lineNumbers} />
          </div>
          {hasMermaidDiagrams && <div class="group">
            <h4 class="title">{m.diagrams}</h4>
            <DiagramStyleSwitcher client:load labels={{ diagramStyle: m.diagramStyle, sketch: m.sketch, classic: m.classic, diagramTheme: m.diagramTheme, matchSite: m.matchSite, darkTheme: m.darkTheme, forestTheme: m.forestTheme }} />
          </div>}
          </>
        )
      }
    </div>
  </div>
</aside>

<style>
  .preferences {
    position: fixed;
    top: calc(var(--navbar-height) + 1px);
    right: calc(var(--sidebar-width) * -1);
    width: var(--sidebar-width);
    height: calc(100dvh - var(--navbar-height) - 1px);
    max-width: 100vw;
    background-color: var(--background-color);
    background-image: none;
    background-repeat: repeat;
    backdrop-filter: blur(10px);
    z-index: 9;
    transition: right 0.3s ease;
    overflow-y: auto;
    box-shadow: -2px 0 5px rgba(var(--background-color-rgb), 0.1);

    &.expanded {
      border-left: none;
    }

    &.active {
      right: 0;
    }

    @media screen and (min-width: 992px) {
      right: -28dvw;
      width: 28dvw;
      height: calc(100dvh - var(--navbar-height) - 1px);
    }

    :global(button) { min-width: 44px; min-height: 44px; }

    .title {
      margin-bottom: 2em;
      color: var(--accent-color);
    }

    .switchers {
      display: flex;
      flex-direction: column;
      gap: 1em;
    }

    .content {
      padding: 1em;
    }

    .group {
      display: flex;
      flex-direction: column;
      gap: 10px;

      :global(button) { min-width: 44px; min-height: 44px; }

    .title {
        margin-bottom: 0.5em;
        color: var(--accent-color);
      }
    }
  }
</style>
