---
import { localeFromPath, messages, type Locale } from "../i18n";
const { tags = [], locale = localeFromPath(Astro.url.pathname) } =
  Astro.props as { tags?: string[]; locale?: Locale };
const m = messages[locale];
---

<div class="filters">
  <label
    >{m.filter}<input
      type="search"
      data-filter-query
      placeholder={m.filter}
    /></label
  >
  <div class="tags-filter" aria-label={m.tags}>
    {
      tags.map((tag: string) => (
        <button type="button" data-filter-tag={tag} aria-pressed="false">
          {tag}
        </button>
      ))
    }
    <button type="button" data-filter-reset>{m.clear}</button>
  </div>
  <p data-filter-empty hidden role="status">{m.noResults}</p>
  <div class="pagination" data-filter-pagination hidden>
    <button type="button" data-filter-prev>{m.previous}</button>
    <span data-filter-count aria-live="polite"></span>
    <button type="button" data-filter-next>{m.next}</button>
  </div>
</div>
<script>
  import "../scripts/filter";
</script>
<style>
  .filters {
    margin: 1rem 0 2rem;
  }
  input {
    display: block;
    width: 100%;
    margin: 0.5rem 0 1rem;
    padding: 0.75rem;
    background: var(--background-color);
    color: var(--foreground-color);
    border: 1px solid var(--border-color);
    border-radius: 0.3rem;
  }
  .tags-filter,
  .pagination {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .pagination {
    margin-top: 1rem;
  }
  button {
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--border-color);
    border-radius: 0.3rem;
    background: var(--background-color);
    color: var(--foreground-color);
    cursor: pointer;
  }
  button[aria-pressed="true"] {
    border-color: var(--accent-color);
    color: var(--accent-color);
  }
  button:disabled {
    opacity: 0.4;
    cursor: default;
  }
  [hidden] {
    display: none;
  }
</style>
