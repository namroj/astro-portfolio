---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import TimelineItem from "./TimelineItem.astro";
import Filter from "./Filter.astro";
import BlogPost from "./BlogPost.astro";
import ProjectLinks from "./ProjectLinks.astro";
import Socials from "./Socials.astro";
import VenezuelaToArgentinaMap from "./VenezuelaToArgentinaMap";
import skills from "../data/skills.json";
import tools from "../data/tools.json";
import { messages, route, localize, type Locale } from "../i18n";
import { blogListingPosts, publishedPosts, postUrl } from "../utils/blog";
import "../styles/timeline.css";
import "../styles/sections.css";
import "../styles/home.css";
const { locale, page = "" } = Astro.props as { locale: Locale; page?: string };
const m = messages[locale];
const skillGroups = [
  {
    title: m.webCommerce,
    names: [
      "React",
      "TypeScript",
      "JavaScript",
      "Node.js",
      "Next.js",
      "Astro",
      "VTEX",
    ],
  },
  {
    title: m.backendData,
    names: ["Java", "Spring", "PHP", "MySQL", "PostgreSQL"],
  },
  {
    title: m.mobile,
    names: ["React Native", "Expo", "iOS", "Android"],
  },
].map(({ title, names }) => ({
  title,
  items: skills.filter((item) => names.includes(item.name)),
}));
const featuredSkillNames = new Set(
  skillGroups.flatMap((group) => group.items.map((item) => item.name)),
);
const additionalSkills = skills.filter(
  (item) => !featuredSkillNames.has(item.name),
);
const featuredToolNames = new Set([
  "AWS",
  "Azure",
  "Docker",
  "GitHub",
  "Postman",
  "Figma",
]);
const featuredTools = tools.filter((item) => featuredToolNames.has(item.name));
const additionalTools = tools.filter(
  (item) => !featuredToolNames.has(item.name),
);
const key = page as keyof typeof m;
const heading =
  page === ""
    ? m.role
    : page === "from-venezuela-to-argentina"
      ? m.journey
      : m[key];
const collection =
  page === "projects"
    ? "projects"
    : page === "experience"
      ? "experience"
      : "education";
const isTimeline = ["projects", "experience", "education"].includes(page);
const items = isTimeline
  ? (await getCollection(collection))
      .filter((item) => !("visible" in item.data) || item.data.visible)
      .map((item) => ({ ...item, data: localize(item.data, locale) }))
  : [];
const posts =
  page === "blog"
    ? blogListingPosts(await getCollection("blog"), locale, import.meta.env.DEV)
    : [];
const tags = [
  ...new Set((isTimeline ? items : posts).flatMap((item) => item.data.tags)),
].sort();
const homeExperience =
  page === ""
    ? (await getCollection("experience"))
        .slice(0, 3)
        .map((item) => ({ ...item, data: localize(item.data, locale) }))
    : [];
const homeProjects =
  page === ""
    ? (await getCollection("projects"))
        .filter((item) => item.data.visible)
        .sort((a, b) => b.data.year - a.data.year)
        .slice(0, 3)
        .map((item) => ({ ...item, data: localize(item.data, locale) }))
    : [];
const homePosts =
  page === ""
    ? publishedPosts(await getCollection("blog"), locale).slice(0, 3)
    : [];
const jsonLd =
  page === ""
    ? {
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Jorman Espinoza",
        jobTitle: m.role,
        url: new URL(route(locale), Astro.site).href,
        sameAs: [
          "https://github.com/namroj",
          "https://www.linkedin.com/in/jormanespinoza",
          "https://x.com/jormandev",
        ],
      }
    : undefined;
---

<Layout title={{ tab: page ? heading : "", page: heading }} jsonLd={jsonLd}>
  {
    page === "" && (
      <>
        <p class="home-intro">{m.homeIntro}</p>
        <div class="home-actions">
          <a class="primary-action" href={route(locale, "projects")}>
            {m.viewWork} →
          </a>
          <a href={route(locale, "contact")}>{m.contact} →</a>
        </div>
        <section class="home-section" id="projects">
          <h2>{m.projects}</h2>
          <ul class="item-list project-list">
            {homeProjects.map((item) => (
              <li class="project-card">
                <a
                  class="project-card-main"
                  href={`${route(locale, "projects")}#${item.id}`}
                >
                  <img
                    src={item.data.logo.path}
                    alt=""
                    width="88"
                    height="88"
                    loading="lazy"
                    style={`background-color: ${item.data.logo.bg_color}`}
                  />
                  <span class="project-card-copy">
                    <span class="project-card-meta">{item.data.year}</span>
                    <strong>{item.data.name}</strong>
                    <span>{item.data.summary}</span>
                    <span class="project-card-stack">
                      {item.data.tags
                        .filter((tag) => !/^\d{4}$/.test(tag))
                        .slice(0, 3)
                        .join(" · ")}
                    </span>
                  </span>
                </a>
                <ProjectLinks {...item.data} />
              </li>
            ))}
          </ul>
          <a class="more" href={route(locale, "projects")}>
            {m.projects} →
          </a>
        </section>
        <section class="home-section" id="experience">
          <h2>{m.experience}</h2>
          <ul class="item-list">
            {homeExperience.map((item) => (
              <li>
                <strong>{item.data.entity.name}</strong>
                <div>{item.data.positions[0]?.title}</div>
                <div class="item-interval">{item.data.interval}</div>
              </li>
            ))}
          </ul>
          <a class="more" href={route(locale, "experience")}>
            {m.experience} →
          </a>
        </section>
        <section class="home-section" id="blog">
          <h2>{m.blog}</h2>
          {homePosts.map((post) => (
            <BlogPost
              url={postUrl(post)}
              title={post.data.title}
              date={post.data.pubDate}
              description={post.data.description}
              image={post.data.image}
              body={post.body}
            />
          ))}
          {homePosts.length === 0 && <p>{m.emptyBlog}</p>}
          <a class="more" href={route(locale, "blog")}>
            {m.blog} →
          </a>
        </section>
        <section class="home-contact">
          <h2>{m.contact}</h2>
          <p>{m.contactText}</p>
          <a class="primary-action" href="mailto:espinoza.dev@gmail.com">
            {m.getInTouch} →
          </a>
        </section>
      </>
    )
  }
  {
    page === "about" && (
      <>
        <>
          <p>{m.aboutText}</p>
          <p>{m.interests}</p>
        </>
        <p>
          <a href={route(locale, "from-venezuela-to-argentina")}>
            {m.journey} →
          </a>
        </p>
        <p>
          <a href={route(locale, "experience")}>{m.experience} →</a> ·{" "}
          <a href={route(locale, "education")}>{m.education} →</a>
        </p>
        <section>
          <h2>{m.skills}</h2>
          <div class="technology-groups">
            {skillGroups.map((group) => (
              <div class="technology-group">
                <h3>{group.title}</h3>
                <ul class="technology-list">
                  {group.items.map((item) => (
                    <li>
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {item.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <div class="technology-group">
            <h3>{m.platformsWorkflow}</h3>
            <ul class="technology-list">
              {featuredTools.map((item) => (
                <li>
                  <a href={item.url} target="_blank" rel="noopener noreferrer">
                    {item.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <details class="more-technologies">
            <summary>{m.moreSkills}</summary>
            <h3>{m.skills}</h3>
            <ul class="technology-list">
              {additionalSkills.map((item) => (
                <li>
                  <a href={item.url} target="_blank" rel="noopener noreferrer">
                    {item.name}
                  </a>
                </li>
              ))}
            </ul>
            <h3>{m.tools}</h3>
            <ul class="technology-list">
              {additionalTools.map((item) => (
                <li>
                  <a href={item.url} target="_blank" rel="noopener noreferrer">
                    {item.name}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </section>
      </>
    )
  }
  {
    isTimeline && (
      <section class="timeline" data-filter-list>
        <Filter tags={tags} locale={locale} />
        <ul class="timeline-list">
          {items.map((item, index) => (
            <TimelineItem
              item={item}
              isLast={index === items.length - 1}
              type={page === "projects" ? "project" : page}
            />
          ))}
        </ul>
      </section>
    )
  }
  {
    page === "blog" && (
      <>
        <section data-filter-list>
          <Filter tags={tags} locale={locale} />
          <div class="blog-list">
            {posts.map((post) => (
              <div data-filter-item data-tags={post.data.tags.join(",")}>
                <BlogPost
                  url={postUrl(post)}
                  title={post.data.title}
                  date={post.data.pubDate}
                  description={post.data.description}
                  image={post.data.image}
                  body={post.body}
                  draft={post.data.draft}
                />
              </div>
            ))}
          </div>
          {posts.length === 0 && <p>{m.emptyBlog}</p>}
        </section>
        <p>
          <a href={route(locale, "blog/tags")}>{m.tags} →</a> ·{" "}
          <a href={route(locale, "rss.xml")}>RSS</a>
        </p>
      </>
    )
  }
  {
    page === "contact" && (
      <>
        <>
          <p>{m.contactText}</p>
          <p>
            <a href="mailto:espinoza.dev@gmail.com">espinoza.dev@gmail.com</a>
          </p>
          <Socials />
        </>
      </>
    )
  }
  {
    page === "from-venezuela-to-argentina" && (
      <>
        <p>{m.intro}</p>
        {
          import.meta.env.GOOGLE_MAPS_API_KEY &&
          import.meta.env.GOOGLE_MAPS_LIGHT_MAP_ID &&
          import.meta.env.GOOGLE_MAPS_DARK_MAP_ID ? (
          <VenezuelaToArgentinaMap client:only="preact" />
        ) : (
          <p>
            <a href="https://www.openstreetmap.org/directions?engine=fossgis_osrm_car&route=10.4806%2C-66.9036%3B-34.6037%2C-58.3816">
              Caracas → Buenos Aires
            </a>
          </p>
          )
        }
      </>
    )
  }
</Layout>
<style>
  p {
    margin: 1.25rem 0;
    line-height: 1.8;
  }
  section {
    margin: 2rem 0;
  }
  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .technology-list a {
    display: block;
    border: 1px solid var(--border-color);
    padding: 0.4rem 0.7rem;
    border-radius: 0.35rem;
  }
</style>
