---
import { localeFromPath, messages } from "../i18n";
interface Props {
  url: string;
  title: string;
  date: Date;
  description: string;
  image: { url: string; alt: string };
  body?: string;
}
const { url, title, date, description, image, body = "" } = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const minutes = Math.max(
  1,
  Math.ceil(body.trim().split(/\s+/).filter(Boolean).length / 200),
);
---

<a class="blog-post-link" href={url}>
  <img
    src={image.url}
    alt=""
    width="240"
    height="160"
    loading="lazy"
    decoding="async"
  />
  <div class="post-content">
    <h3>{title}</h3>
    <p>{description}</p>
    <div class="post-meta">
      <time datetime={date.toISOString()}
        >{
          date.toLocaleDateString(locale === "en" ? "en-US" : "es-AR", {
            day: "numeric",
            month: "short",
            year: "numeric",
          })
        }</time
      >
      <span>{minutes} {messages[locale].readingTime}</span>
    </div>
  </div>
  <span class="arrow" aria-hidden="true">→</span>
</a>
<style>
  .blog-post-link {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border-color);
  }
  img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 0.4rem;
  }
  h3 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
    color: var(--foreground-color);
  }
  p {
    margin: 0 0 0.75rem;
    font: 0.95rem/1.6 var(--prose-font);
    color: var(--foreground-color);
  }
  .post-meta {
    display: flex;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
    color: var(--accent-muted-color);
    font-size: 0.75rem;
  }
  .arrow,
  .blog-post-link:hover h3 {
    color: var(--accent-color);
  }
  @media (max-width: 600px) {
    .blog-post-link {
      grid-template-columns: 5rem minmax(0, 1fr);
      gap: 0.75rem;
      align-items: start;
    }
    .arrow {
      display: none;
    }
  }
</style>
