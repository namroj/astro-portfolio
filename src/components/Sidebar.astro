---
import Socials from "./Socials.astro";
import { localeFromPath, navigation, route, messages } from "../i18n";
const locale = localeFromPath(Astro.url.pathname);
const m = messages[locale];
---

<aside class="sidebar">
  <div class="sidebar-content">
    <div class="intro-section">
      <p class="name"><a href={route(locale)}>Jorman Espinoza</a></p>
      <p class="tagline">{m.role}</p>
      <p class="description">{m.intro}</p>
    </div>
    <nav
      class="main-nav"
      aria-label={locale === "en" ? "Main navigation" : "Navegación principal"}
    >
      <ul>
        {
          navigation(locale).map((link) => (
            <li>
              <a
                href={link.url}
                class={Astro.url.pathname.startsWith(link.url) ? "active" : ""}
                aria-current={
                  Astro.url.pathname === link.url ? "page" : undefined
                }
              >
                <>
                  <span class="nav-indicator" />
                  <span class="nav-text">{link.label}</span>
                </>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="sidebar-footer"><Socials template="icons" /></div>
  </div>
</aside>
<style>
  .sidebar {
    display: none;
  }

  @media screen and (min-width: 1024px) {
    .sidebar {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      width: 45%;
      max-width: 600px;
      padding: 6rem 4rem;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
    }

    .sidebar-content {
      display: flex;
      flex-direction: column;
      gap: 4rem;
      height: 100%;
    }

    .intro-section {
      flex-shrink: 0;
    }

    .name {
      font-size: clamp(2.5rem, 4vw, 3.5rem);
      font-weight: 700;
      margin-bottom: 0.5rem;
      line-height: 1.1;
    }

    .name a {
      color: var(--foreground-color);
      transition: color 0.2s ease;
    }

    .name a:hover {
      color: var(--accent-color);
    }

    .tagline {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--foreground-color);
      margin-bottom: 1rem;
    }

    .description {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--accent-secondary-color);
      max-width: 400px;
    }

    .main-nav {
      flex: 1;
      display: flex;
      align-items: center;
    }

    .main-nav ul {
      list-style: none;
      padding: 0;
      margin: 0;
      width: 100%;
    }

    .main-nav li {
      margin-bottom: 0.5rem;
    }

    .main-nav a {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem 0;
      text-transform: uppercase;
      font-size: 0.875rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: var(--accent-secondary-color);
      transition: all 0.2s ease;
      position: relative;
    }

    .nav-indicator {
      width: 2rem;
      height: 1px;
      background: var(--accent-secondary-color);
      transition: all 0.2s ease;
    }

    .main-nav a:hover .nav-indicator,
    .main-nav a.active .nav-indicator {
      width: 4rem;
      background: var(--accent-color);
    }

    .main-nav a:hover .nav-text,
    .main-nav a.active .nav-text {
      color: var(--foreground-color);
    }

    .sidebar-footer {
      flex-shrink: 0;
      margin-top: auto;
    }
  }

  @media screen and (min-width: 1280px) {
    .sidebar {
      padding: 6rem 6rem;
    }
  }
</style>
