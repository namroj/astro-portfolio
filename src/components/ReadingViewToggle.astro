---
import { localeFromPath } from '../i18n';
const english = localeFromPath(Astro.url.pathname) === 'en';
const expand = english ? 'Expand reading view' : 'Ampliar vista de lectura';
const restore = english ? 'Restore reading view' : 'Restaurar vista de lectura';
---
<button id="reading-view-toggle" type="button" hidden
  aria-label={expand} title={expand} aria-pressed="false"
  data-expand-label={expand} data-restore-label={restore}>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path class="expand-icon" d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" />
    <path class="restore-icon" d="M3 8h5V3m8 0v5h5M8 21v-5H3m18 0h-5v5" />
  </svg>
</button>
<style>
  button {
    width: var(--control-size);
    height: var(--control-size);
    border-radius: 50%;
    background: transparent;
    color: var(--foreground-color);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 5px rgba(var(--accent-color-rgb), 0.5);
  }
  button:hover { background: var(--accent-color); }
  button:focus-visible { outline: 2px solid var(--accent-color); outline-offset: 4px; }
  .restore-icon, [aria-pressed="true"] .expand-icon { display: none; }
  [aria-pressed="true"] .restore-icon { display: block; }
</style>
<script>
  import { initializeReadingView } from '../scripts/reading-view';
  initializeReadingView();
</script>
