---
import PortfolioPage from "../../components/PortfolioPage.astro";
import { locales } from "../../i18n";
export function getStaticPaths() {
  return locales.flatMap((locale) =>
    [
      "",
      "about",
      "education",
      "experience",
      "projects",
      "blog",
      "contact",
      "from-venezuela-to-argentina",
    ].map((page) => ({
      params: { lang: locale, page: page || undefined },
      props: { locale, page },
    })),
  );
}
const { locale, page } = Astro.props;
---

<PortfolioPage locale={locale} page={page} />
