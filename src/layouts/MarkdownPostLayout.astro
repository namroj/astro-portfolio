---
import Layout from "./Layout.astro";
import { slugify } from "../utils/slugify";
import { localeFromPath, messages, route } from "../i18n";
const locale = localeFromPath(Astro.url.pathname);
const m = messages[locale];
import "../styles/code-block.css";

const { frontmatter } = Astro.props;

const title = {
  tab: `Blog: ${frontmatter.title}`,
  page: frontmatter.title,
};

const breadCrumbs = [
  {
    url: route(locale, "blog"),
    label: "Blog",
  },
  {
    url: "",
    label: frontmatter.title,
  },
];

const tags = [
  ...new Set(frontmatter.tags.map((tag: string) => tag.toLowerCase())),
];

const baseUrl = Astro.site?.toString() || "https://jormanespinoza.netlify.app";
const articleUrl = new URL(Astro.url.pathname, baseUrl).toString();

const seo = {
  title: `${frontmatter.title} • Jorman Espinoza`,
  description: frontmatter.description,
  url: articleUrl,
  image: {
    ...frontmatter.image,
    url: new URL(frontmatter.image.url, baseUrl).href,
  },
  type: "article",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: frontmatter.title,
  description: frontmatter.description,
  author: {
    "@type": "Person",
    name: frontmatter.author,
  },
  datePublished: frontmatter.pubDate.toISOString(),
  image: new URL(frontmatter.image.url, baseUrl).href,
  url: articleUrl,
  keywords: frontmatter.tags.join(", "),
};
---

<style>
  .post {
    .tags {
      margin-bottom: 1em;
      display: flex;
      gap: 0.5em;

      .tag {
        padding: 0.25em 0.75em;
        border-radius: 25px;
        font-size: 0.75em;
        color: var(--accent-muted-color);
        cursor: pointer;

        a:hover {
          color: var(--accent-secondary-color);
        }

        &:hover,
        &.highlight-tag {
          background: transparent;
          border-color: var(--accent-color);
        }
      }
    }

    h2 {
      color: var(--accent-secondary-color);
    }

    p,
    li {
      margin-bottom: 0.5em;
    }

    p.written-by {
      margin-top: 1em;
      text-align: right;
    }

    code,
    pre,
    .code {
      padding: 0.5em;
      margin: 0.5em 0;
      border-radius: 6px;
      overflow-x: auto;
      font-family: var(--code-font), monospace;
      font-feature-settings:
        "calt" 1,
        "liga" 1;
      line-height: calc(var(--line-height) * 1.25);
      font-size: 1em;
    }

    li {
      list-style: disc;
      margin-left: 2em;
    }

    pre {
      & code {
        & .line {
          width: auto !important;
        }
      }
    }
  }
</style>

<Layout title={title} breadCrumbs={breadCrumbs} seo={seo} jsonLd={jsonLd}>
  <div class="post" transition:name={frontmatter.name}>
    <div class="tags">
      {
        tags.map((tag: any) => (
          <p class="tag">
            <a href={route(locale, `blog/tags/${slugify(tag)}`)}>{tag}</a>
          </p>
        ))
      }
    </div>
    <span>{frontmatter.id}</span>
    <p>
      {
        new Date(frontmatter.pubDate).toLocaleDateString(
          locale === "en" ? "en-US" : "es-AR",
          {
            day: "2-digit",
            month: "long",
            year: "numeric",
          },
        )
      }
    </p>
    <p><em>{frontmatter.description}</em></p>
    <img src={frontmatter.image.url} width="300" alt={frontmatter.image.alt} />
    <slot />
    <p class="written-by">{m.by}: {frontmatter.author}</p>
  </div>
</Layout>

<script src="../scripts/code-block.js"></script>
